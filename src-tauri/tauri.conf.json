{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MarkItDown Desktop",
  "version": "1.1.0",
  "identifier": "io.github.mhabachia.markitdown",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MarkItDown Desktop Studio",
        "width": 1260,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzNTk3QkZDQzI2QkY1RUMKUldUczlXdkMvSHRaMCtRL0pJcFYvdEhSUEpveFZEQU1JU0RDNlROcGh5YjBKYUlxSGRwNHlHc1UK",
      "endpoints": [
        "https://github.com/MHabachia/markitdown-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
