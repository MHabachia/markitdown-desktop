{
  "name": "markitdown-desktop",
  "productName": "MarkItDown Desktop",
  "version": "1.1.3",
  "description": "Desktop-App, die Dokumente lokal mit Microsoft MarkItDown in Markdown umwandelt",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "backend": ".venv/bin/python backend/api.py",
    "sidecar": ".venv/bin/python scripts/build_standalone.py",
    "tauri:build:standalone": "npm run sidecar && tauri build --config src-tauri/tauri.sidecar.conf.json",
    "start": "concurrently \".venv/bin/python backend/api.py\" \"vite\"",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": ".venv/bin/python -m unittest discover -s backend/tests -t .",
    "lint": "oxlint --deny-warnings",
    "test:ui": "vitest run",
    "test:e2e": "playwright test",
    "version:set": "python3 scripts/set_version.py"
  },
  "keywords": [],
  "author": "MHabachia",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.14.0",
    "dompurify": "3.4.17",
    "lucide-react": "^1.57.0",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "30.1.2",
    "oxlint": "1.90.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "5.0.4"
  },
  "private": true,
  "engines": {
    "node": ">=22.12"
  }
}
